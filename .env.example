# Reference only: the gateway does not automatically load .env files.
# Generate a distinct secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# export GATEWAY_CLIENT_KEYS_JSON='{"demo-client":"<generated-key>"}'
GATEWAY_CONFIG=config/mock.toml
